<Window
    x:Class="Xilium.CefGlue.Demo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="Toolbar" Orientation="Horizontal" Grid.Row="0" Padding="6" Spacing="6">
            <TextBox x:Name="AddressTextBox" Width="600" KeyDown="OnAddressTextBoxKeyDown"/>
            <Button Content="Go" Click="OnGoButtonClick"/>
            <Button Content="Reload" Click="OnReloadButtonClick"/>
            <Button Content="DevTools" Click="OnOpenDevToolsButtonClick"/>
        </StackPanel>

        <Grid x:Name="BrowserContainer" Grid.Row="1"/>
    </Grid>
</Window>

<Window x:Class="Xilium.CefGlue.Demo.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CefGlue.WPF Demo" Width="1024" Height="768">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="Toolbar" Orientation="Horizontal" Grid.Row="0" Margin="6">
            <TextBox x:Name="AddressTextBox" Width="600" Margin="0,0,6,0" KeyDown="OnAddressTextBoxKeyDown"/>
            <Button Content="Go" Width="60" Margin="0,0,6,0" Click="OnGoButtonClick"/>
            <Button Content="Reload" Width="60" Margin="0,0,6,0" Click="OnReloadButtonClick"/>
            <Button Content="DevTools" Width="70" Click="OnOpenDevToolsButtonClick"/>
        </StackPanel>

        <Grid x:Name="BrowserContainer" Grid.Row="1"/>
    </Grid>
</Window>

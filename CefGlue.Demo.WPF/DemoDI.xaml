<Window x:Class="Xilium.CefGlue.Demo.WPF.DemoDI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CefGlue WPF Demo - DI (DemoDI)" Width="1000" Height="650"
        Loaded="DemoDI_Loaded">

    <DockPanel>
        <Menu x:Name="mainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Tab" Click="OnNewTabMenuItemClick" />
                <MenuItem Header="_Close Tab" Click="OnCloseTabMenuItemClick" />
                <MenuItem Header="_Open Dev Tools..." Click="OnOpenDevToolsMenuItemClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="showOverlayInfoMenuItem" Header="Show _Overlay Info"
                          IsCheckable="True" IsChecked="False" Click="OnShowOverlayInfoMenuItemClick" />
                <MenuItem x:Name="showActivityLogMenuItem" Header="Show _Activity Log"
                          IsCheckable="True" IsChecked="False" Click="OnShowActivityLogMenuItemClick" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="statusText" Text="Done" VerticalAlignment="Center" />
            </StatusBarItem>

            <StatusBarItem Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider x:Name="zoomSlider" Minimum="-5" Maximum="5" Value="0" Width="220"
                            TickFrequency="1" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock x:Name="zoomValueText" Text="0.0" Width="32" VerticalAlignment="Center"
                               Margin="6,0,6,0" />
                    <Button Content="Reset" Padding="8,2,8,2" Click="OnResetZoomClick" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="activityLogRow" Height="0" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TabControl x:Name="tabControl" SelectionChanged="TabControl_SelectionChanged" />

                <Grid x:Name="fullscreenHost" Background="Black" Visibility="Collapsed" />
            </Grid>

            <GridSplitter x:Name="listSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="LightGray" Visibility="Collapsed" />

            <ListBox x:Name="activityList" Grid.Row="2" Focusable="False" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
